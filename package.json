{
  "name": "lumi-analytics",
  "version": "1.0.0",
  "description": "LUMI Analytics — Productivity & Adoption Dashboard for Figma",
  "scripts": {
    "build": "npm run build:ui && npm run build:main",
    "build:main": "node scripts/build-main.mjs",
    "build:ui": "vite build && node scripts/rename-ui-html.mjs",
    "watch": "npm run build && echo 'Rebuild complete. Re-import plugin in Figma if needed.'",
    "dev": "npm run build",
    "analyze:cloud": "tsx src/cli/index.ts",
    "test:jira": "tsx src/productivity/jiraTicketMatcher.test.ts",
    "test:start-session": "tsx src/productivity/startSessionInference.test.ts",
    "test:jira-board": "tsx src/integrations/jira/jiraBoardSync.test.ts",
    "test:jira-cache": "tsx src/integrations/jira/jiraCache.test.ts",
    "test:workload": "tsx src/productivity/designerWorkloadSummary.test.ts",
    "test:ds-benchmark": "tsx src/backend/designSystemBenchmark.test.ts",
    "test:lumi-admin": "tsx src/backend/lumiAdoptionAdmin.test.ts",
    "test:scan-storage": "tsx src/productivity/scanStorage.test.ts",
    "test:session-heartbeat": "tsx src/productivity/sessionHeartbeat.test.ts",
    "jira-proxy": "node server/jira-proxy.mjs",
    "sync:jira": "tsx scripts/sync-jira-tickets.ts",
    "sync:libraries": "tsx scripts/sync-design-system-libraries.ts",
    "analytics-api": "tsx scripts/serve-analytics-api.ts",
    "analytics-api:restart": "lsof -ti :8788 | xargs kill 2>/dev/null; sleep 0.5; tsx scripts/serve-analytics-api.ts",
    "report:send": "tsx scripts/send-lumi-report.ts",
    "report:preview": "tsx scripts/send-lumi-report.ts --preview",
    "report:test-smtp": "tsx scripts/test-smtp.ts",
    "report:schedule": "tsx scripts/schedule-lumi-report.ts",
    "test:lumi-report": "tsx src/backend/lumiReportService.test.ts",
    "build:with-jira": "npm run sync:jira && npm run build",
    "build:with-libraries": "npm run sync:libraries && npm run build",
    "test": "npm run test:jira && npm run test:start-session && npm run test:jira-board && npm run test:jira-cache && npm run test:workload && npm run test:ds-benchmark && npm run test:lumi-admin && npm run test:scan-storage && npm run test:session-heartbeat && npm run test:lumi-report"
  },
  "dependencies": {
    "figma-calculations": "^0.1.89-alpha",
    "nodemailer": "^7.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.121.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^17.4.2",
    "esbuild": "^0.24.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
