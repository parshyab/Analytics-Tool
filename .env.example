# -------------------------------
# FIGMA
# -------------------------------
FIGMA_API_TOKEN=your_figma_personal_access_token
FIGMA_TEAM_IDS=your_figma_team_id
FIGMA_FILE_ID=your_figma_file_key

# -------------------------------
# JIRA
# -------------------------------
JIRA_BASE_URL=https://nykmage.atlassian.net
JIRA_EMAIL=your.email@nykaa.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=UX
JIRA_DEFAULT_JQL=project = UX AND created >= "2026-03-31" AND created < "2027-04-01" ORDER BY components DESC
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_SPRINT_FIELD=

# Optional
# JIRA_CACHE_OUTPUT=src/generated/jira-cache.json
# JIRA_MAX_RESULTS=100

# -------------------------------
# FIGMA LIBRARY REGISTRY
# -------------------------------
# FIGMA_API_TOKEN is used only by backend sync scripts — never bundled into the plugin UI.

LUMI_LIBRARY_FILE_KEY=
NDS_BEAUTY_LIBRARY_FILE_KEY=
NDS_FASHION_LIBRARY_FILE_KEY=

# Optional legacy libraries as JSON array
# LEGACY_DESIGN_SYSTEM_LIBRARIES_JSON=[]

# Optional: plugin cache output path
# DS_REGISTRY_CACHE_OUTPUT=src/generated/design-system-registry.json

# LUMI Analytics API (local backend for benchmark snapshots)
# LUMI_ANALYTICS_API_PORT=8788
# LUMI_ANALYTICS_API_URL=http://localhost:8788
# LUMI_ANALYTICS_OWNER_KEY=

# Admin emails (comma-separated) — full admin nav + LUMI efficiency insights
# LUMI_ADMIN_EMAILS=your.email@nykaa.com

# -------------------------------
# STAKEHOLDER REPORTS (admin-selected)
# -------------------------------
# Dropdown options in Export → Send performance report (NOT an auto-send list)
LUMI_REPORT_RECIPIENT_OPTIONS=sudhakar.pandey@nykaa.com,vipul.gupta@nykaa.com,jay.hasija@nykaa.com,rajesh@nykaa.com,parshyajyoti.bora@nykaa.com

# Write HTML/CSV under data/reports instead of sending (default until SMTP is set)
LUMI_REPORT_DRY_RUN=true

# SMTP (Google Workspace / Gmail)
# LUMI_SMTP_HOST=smtp.gmail.com
# LUMI_SMTP_PORT=587
# LUMI_SMTP_SECURE=false
# LUMI_SMTP_USER=your.email@nykaa.com
# LUMI_SMTP_PASS=google-app-password-16-chars
# LUMI_SMTP_FROM="LUMI Analytics <your.email@nykaa.com>"

# Optional: only for scheduled CI when you explicitly want automation
# LUMI_REPORT_EMAILS=
